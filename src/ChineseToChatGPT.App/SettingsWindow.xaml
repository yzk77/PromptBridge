<Window x:Class="ChineseToChatGPT.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource SettingsTitle}"
        Width="1180" Height="780" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        SizeChanged="SettingsWindow_SizeChanged"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="译" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource ProductTitle}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click">
                    <Path Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource TitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeButton_Click">
                    <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource CloseTitleBarButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click">
                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="NavigationPanel" Margin="8,22,8,0">
                    <Button Style="{StaticResource NavigationItem}" Tag="Overview" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconOverview}" Style="{StaticResource NavigationIcon}"/><TextBlock Text="{DynamicResource NavOverview}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationItem}" Tag="Providers" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconProviders}" Style="{StaticResource NavigationIcon}"/><TextBlock Text="{DynamicResource NavProviders}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationItem}" Tag="Behavior" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconBehavior}" Style="{StaticResource NavigationIcon}"/><TextBlock Text="{DynamicResource NavBehavior}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationItem}" Tag="Failover" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFailover}" Style="{StaticResource NavigationIcon}"/><TextBlock Text="{DynamicResource NavFailover}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationItem}" Tag="Privacy" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPrivacy}" Style="{StaticResource NavigationIcon}"/><TextBlock Text="{DynamicResource NavPrivacy}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationItem}" Tag="About" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconAbout}" Style="{StaticResource NavigationIcon}"/><TextBlock Text="{DynamicResource NavAbout}"/></StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Margin="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource RunningStatus}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                   Text="{DynamicResource TrayServiceActive}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1">
                <!-- Overview -->
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,28,28,44">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource OverviewTitle}"/>
                            <Border Style="{StaticResource StatusBadge}" Margin="14,3,0,0">
                                <TextBlock Text="{DynamicResource RunningStatus}" Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                        </StackPanel>
                        <Grid Margin="0,8,0,24">
                            <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                       Text="{DynamicResource OverviewDescription}"/>
                        </Grid>
                        <Grid x:Name="OverviewPrimaryCards">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="OverviewHotkeyCard" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource GlobalHotkeyTitle}"/>
                                    <ItemsControl x:Name="OverviewHotkeyKeys" Margin="0,18,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource HotkeyCardDescription}"/>
                                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                            Content="{DynamicResource Modify}" Tag="Behavior"
                                            Click="NavigationButton_Click"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="OverviewSendCard" Grid.Column="1" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource SendingBehaviorTitle}"/>
                                    <UniformGrid Columns="2" Margin="0,18,0,8">
                                        <Button x:Name="OverviewImmediateButton" Style="{StaticResource PrimaryButton}"
                                                Content="{DynamicResource SendImmediately}" Tag="Immediate"
                                                Click="OverviewSendMode_Click"/>
                                        <Button x:Name="OverviewPreviewButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource PreviewBeforeSendingShort}" Tag="Preview"
                                                Click="OverviewSendMode_Click"/>
                                    </UniformGrid>
                                    <TextBlock x:Name="OverviewSendModeText" Visibility="Collapsed"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource SendingBehaviorDescription}"/>
                                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                            Content="{DynamicResource Modify}" Tag="Behavior"
                                            Click="NavigationButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource ProviderHealthTitle}"/>
                                <ItemsControl x:Name="OverviewProviderStatusList" Margin="0,12,0,0"/>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Content="{DynamicResource ConfigureProviders}" Tag="Providers"
                                        Click="NavigationButton_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource FailoverOrderTitle}"/>
                                <ItemsControl x:Name="OverviewPriorityItems" Margin="0,14,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="OverviewPriorityText" Visibility="Collapsed"/>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Content="{DynamicResource AdjustOrder}" Tag="Failover"
                                        Click="NavigationButton_Click"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RecentActivityCard" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource RecentActivityTitle}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,16,0,8"
                                           Text="{DynamicResource NoRecentActivity}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Providers -->
                <ScrollViewer x:Name="ProvidersPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,28,28,44">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource ProvidersTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,20"
                                   Text="{DynamicResource ProvidersDescription}"/>
                        <UniformGrid x:Name="ProviderQuickButtons" Columns="4" Margin="0,0,0,18">
                            <Button x:Name="AlibabaProviderButton" Style="{StaticResource SecondaryButton}" Tag="AlibabaCloud"
                                    HorizontalContentAlignment="Stretch"
                                    Click="ProviderCard_Click">
                                <Grid><TextBlock Text="{DynamicResource ProviderAlibaba}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="AlibabaCardStatus" HorizontalAlignment="Right" Foreground="{DynamicResource InfoBrush}"/></Grid>
                            </Button>
                            <Button x:Name="BaiduProviderButton" Style="{StaticResource SecondaryButton}" Tag="Baidu"
                                    HorizontalContentAlignment="Stretch"
                                    Click="ProviderCard_Click">
                                <Grid><TextBlock Text="{DynamicResource ProviderBaidu}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="BaiduCardStatus" HorizontalAlignment="Right" Foreground="{DynamicResource InfoBrush}"/></Grid>
                            </Button>
                            <Button x:Name="TencentProviderButton" Style="{StaticResource SecondaryButton}" Tag="TencentCloud"
                                    HorizontalContentAlignment="Stretch"
                                    Click="ProviderCard_Click">
                                <Grid><TextBlock Text="{DynamicResource ProviderTencent}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TencentCardStatus" HorizontalAlignment="Right" Foreground="{DynamicResource InfoBrush}"/></Grid>
                            </Button>
                            <Button x:Name="GoogleProviderButton" Style="{StaticResource SecondaryButton}" Tag="Google"
                                    HorizontalContentAlignment="Stretch"
                                    Click="ProviderCard_Click">
                                <Grid><TextBlock Text="{DynamicResource ProviderGoogle}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="GoogleCardStatus" HorizontalAlignment="Right" Foreground="{DynamicResource InfoBrush}"/></Grid>
                            </Button>
                        </UniformGrid>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource ProviderConfiguration}"/>
                                    <TextBlock Grid.Column="1" x:Name="CredentialStatus"
                                               Foreground="{DynamicResource InfoBrush}" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,18,0,0">
                                    <StackPanel x:Name="GoogleProviderPanel" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource GoogleApiKey}"/>
                                        <Grid><PasswordBox x:Name="GoogleApiKeyBox"/><TextBox x:Name="GoogleApiKeyTextBox" Visibility="Collapsed"/></Grid>
                                        <TextBlock Text="{DynamicResource MonthlyCharacterLimit}"/>
                                        <TextBox x:Name="GoogleQuotaBox"/>
                                    </StackPanel>
                                    <StackPanel x:Name="AlibabaProviderPanel">
                                        <TextBlock Text="{DynamicResource AccessKeyId}"/>
                                        <Grid><PasswordBox x:Name="AlibabaAccessKeyIdBox"/><TextBox x:Name="AlibabaAccessKeyIdTextBox" Visibility="Collapsed"/></Grid>
                                        <TextBlock Text="{DynamicResource AccessKeySecret}"/>
                                        <Grid><PasswordBox x:Name="AlibabaAccessKeySecretBox"/><TextBox x:Name="AlibabaAccessKeySecretTextBox" Visibility="Collapsed"/></Grid>
                                        <TextBlock Text="{DynamicResource MonthlyCharacterLimit}"/>
                                        <TextBox x:Name="AlibabaQuotaBox"/>
                                    </StackPanel>
                                    <StackPanel x:Name="BaiduProviderPanel" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource AppId}"/>
                                        <Grid><PasswordBox x:Name="BaiduAppIdBox"/><TextBox x:Name="BaiduAppIdTextBox" Visibility="Collapsed"/></Grid>
                                        <TextBlock Text="{DynamicResource SecretKey}"/>
                                        <Grid><PasswordBox x:Name="BaiduSecretKeyBox"/><TextBox x:Name="BaiduSecretKeyTextBox" Visibility="Collapsed"/></Grid>
                                        <TextBlock Text="{DynamicResource MonthlyCharacterLimit}"/>
                                        <TextBox x:Name="BaiduQuotaBox"/>
                                    </StackPanel>
                                    <StackPanel x:Name="TencentProviderPanel" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource SecretId}"/>
                                        <Grid><PasswordBox x:Name="TencentSecretIdBox"/><TextBox x:Name="TencentSecretIdTextBox" Visibility="Collapsed"/></Grid>
                                        <TextBlock Text="{DynamicResource SecretKey}"/>
                                        <Grid><PasswordBox x:Name="TencentSecretKeyBox"/><TextBox x:Name="TencentSecretKeyTextBox" Visibility="Collapsed"/></Grid>
                                        <TextBlock Text="{DynamicResource TencentRegion}"/>
                                        <TextBox x:Name="TencentRegionBox"/>
                                        <TextBlock Text="{DynamicResource MonthlyCharacterLimit}"/>
                                        <TextBox x:Name="TencentQuotaBox"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <ToggleButton x:Name="ShowSecretsBox" Style="{StaticResource SecondaryToggleButton}"
                                                  Checked="ShowSecretsBox_Changed" Unchecked="ShowSecretsBox_Changed">
                                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconEye}" Width="17" Height="17" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource ShowSecrets}"/></StackPanel>
                                    </ToggleButton>
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource ReplaceCredentials}"
                                            Click="ReplaceCredentials_Click"/>
                                    <Button Style="{StaticResource DangerButton}" Content="{DynamicResource DeleteCredentials}"
                                            Click="DeleteCredentials_Click"/>
                                    <Button x:Name="TestButton" Style="{StaticResource PrimaryButton}"
                                            Content="{DynamicResource TestProviderTab}" Click="TestButton_Click"/>
                                </WrapPanel>
                                <Border x:Name="ProviderTestResultPanel" Visibility="Collapsed"
                                        Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                    <TextBlock x:Name="ProviderTestResultText" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Behavior -->
                <ScrollViewer x:Name="BehaviorPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,28,28,44">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource BehaviorTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,20" Text="{DynamicResource BehaviorDescription}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource GlobalHotkeyTitle}"/>
                                <TextBox x:Name="HotkeyBox" Visibility="Collapsed"/>
                                <Grid Margin="0,16,0,0">
                                    <ItemsControl x:Name="BehaviorHotkeyKeys">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                            Content="{DynamicResource RecordHotkey}" Click="RecordHotkey_Click"/>
                                </Grid>
                                <TextBlock x:Name="HotkeyRecordingText" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                           Visibility="Collapsed" Text="{DynamicResource RecordingHotkeyHint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource AfterTranslation}"/>
                                <UniformGrid Columns="2" Margin="0,16,0,0">
                                    <Button x:Name="ImmediateModeButton" Tag="Immediate" Click="SendModeButton_Click">
                                        <StackPanel><TextBlock Text="{DynamicResource SendImmediately}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ImmediateModeDescriptionText" Text="{DynamicResource ImmediateModeDescription}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
                                    </Button>
                                    <Button x:Name="PreviewModeButton" Tag="Preview" Click="SendModeButton_Click">
                                        <StackPanel><TextBlock Text="{DynamicResource PreviewBeforeSendingShort}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="PreviewModeDescriptionText" Text="{DynamicResource PreviewModeDescription}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource StartupBehavior}"/>
                                <Grid Margin="0,14,0,8">
                                    <TextBlock Text="{DynamicResource LaunchAtLogin}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="LaunchAtLoginBox" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource TrayDoubleClickHint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource SoftwareLanguage}"/>
                                <UniformGrid Columns="2" Margin="0,16,0,0">
                                    <Button x:Name="ChineseLanguageButton" Content="简体中文" Tag="SimplifiedChinese" Click="LanguageButton_Click"/>
                                    <Button x:Name="EnglishLanguageButton" Content="English" Tag="English" Click="LanguageButton_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Failover -->
                <ScrollViewer x:Name="FailoverPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,28,28,44">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource FailoverTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,20" Text="{DynamicResource FailoverDescription}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource TranslationModeTitle}"/>
                                <UniformGrid Columns="2" Margin="0,16,0,10">
                                    <Button x:Name="AutomaticModeButton" Tag="Automatic" Click="TranslationModeButton_Click"
                                            Content="{DynamicResource AutomaticRecommended}"/>
                                    <Button x:Name="FixedModeButton" Tag="Fixed" Click="TranslationModeButton_Click"
                                            Content="{DynamicResource FixedProviderMode}"/>
                                </UniformGrid>
                                <StackPanel x:Name="FixedProviderPanel" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource FixedUsing}"/>
                                    <ComboBox x:Name="FixedProviderBox" SelectionChanged="FixedProviderBox_SelectionChanged">
                                        <ComboBoxItem Tag="AlibabaCloud" Content="{DynamicResource ProviderAlibaba}"/>
                                        <ComboBoxItem Tag="Baidu" Content="{DynamicResource ProviderBaidu}"/>
                                        <ComboBoxItem Tag="TencentCloud" Content="{DynamicResource ProviderTencent}"/>
                                        <ComboBoxItem Tag="Google" Content="{DynamicResource ProviderGoogle}"/>
                                    </ComboBox>
                                    <TextBlock x:Name="FixedProviderWarning" Foreground="{DynamicResource WarningBrush}"
                                               Visibility="Collapsed" Text="{DynamicResource FixedProviderNotConfigured}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ListBox x:Name="ProviderPriorityList" MinHeight="180"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource MoveUp}" Click="MovePriorityUp_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource MoveDown}" Click="MovePriorityDown_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource LocalQuotaTitle}"/>
                                <TextBlock Text="Google"/><TextBox x:Name="GoogleQuotaMirrorBox" TextChanged="QuotaMirror_TextChanged"/>
                                <TextBlock Text="Alibaba Cloud"/><TextBox x:Name="AlibabaQuotaMirrorBox" TextChanged="QuotaMirror_TextChanged"/>
                                <TextBlock Text="Baidu"/><TextBox x:Name="BaiduQuotaMirrorBox" TextChanged="QuotaMirror_TextChanged"/>
                                <TextBlock Text="Tencent Cloud"/><TextBox x:Name="TencentQuotaMirrorBox" TextChanged="QuotaMirror_TextChanged"/>
                            </StackPanel>
                        </Border>
                        <Expander Header="{DynamicResource AdvancedRules}" Foreground="{DynamicResource PrimaryTextBrush}">
                            <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource FailoverRulesText}"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Privacy -->
                <ScrollViewer x:Name="PrivacyPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,28,28,44">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource PrivacyTitle}"/>
                        <Border Style="{StaticResource SettingsCard}" BorderBrush="{DynamicResource InfoBrush}">
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource PrivacyConsoleNotice}"/>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid Margin="0,4,0,12">
                                    <TextBlock Text="{DynamicResource EnableDiagnostics}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="DiagnosticsBox" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4,0,12">
                                    <TextBlock Text="{DynamicResource ShowRecentActivity}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ShowRecentActivityBox" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}" Text="%LocalAppData%\ChineseToChatGPT\logs"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource OpenDiagnostics}" Click="OpenDiagnostics_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource CopyDiagnostics}" Click="CopyDiagnostics_Click"/>
                                    <Button Style="{StaticResource DangerButton}" Content="{DynamicResource ClearDiagnostics}" Click="ClearDiagnostics_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Expander Header="{DynamicResource LogContentsTitle}" Foreground="{DynamicResource PrimaryTextBrush}">
                            <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource LogContentsDescription}"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- About -->
                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,28,28,44">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource AboutTitle}"/>
                        <Border Style="{StaticResource SettingsCard}" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{DynamicResource AppName}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,12,0,0" Text="{DynamicResource AboutVersion}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Text="Windows x64 · .NET 8 · WPF"/>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Text="{DynamicResource AboutCredentialStorage}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,18,0,0" Text="%LocalAppData%\ChineseToChatGPT"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DirtyIndicator" Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource NoUnsavedChanges}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="DiscardChangesButton" Style="{StaticResource SecondaryButton}" Content="{DynamicResource DiscardChanges}" Click="DiscardButton_Click"/>
                        <Button x:Name="SaveChangesButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource SaveChanges}" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
